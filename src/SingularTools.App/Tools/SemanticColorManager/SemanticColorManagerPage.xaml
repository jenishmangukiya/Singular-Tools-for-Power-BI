<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SingularTools_App.Tools.SemanticColorManager.SemanticColorManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SingularTools_App.Tools.SemanticColorManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent" Padding="{StaticResource ToolPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Row 0 · Header + history  -->
        <Grid Grid.Row="0" Margin="0,0,0,10" ColumnSpacing="{StaticResource SpaceM}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Color Sync" />
                <TextBlock
                    Style="{StaticResource MutedCaptionTextStyle}"
                    Text="Color matching values the same across the whole report, or only on selected pages."
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="{StaticResource SpaceS}">
                <Button
                    x:Name="UndoButton"
                    Width="40"
                    Height="40"
                    AutomationProperties.Name="Undo"
                    Click="Undo_Click"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="Undo (Ctrl+Z)">
                    <FontIcon FontSize="15" Glyph="&#xE7A7;" />
                </Button>
                <Button
                    x:Name="RedoButton"
                    Width="40"
                    Height="40"
                    AutomationProperties.Name="Redo"
                    Click="Redo_Click"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="Redo (Ctrl+Y)">
                    <FontIcon FontSize="15" Glyph="&#xE7A6;" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  Row 1 · Toolbar  -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                <Button
                    x:Name="ApplyButton"
                    Click="Apply_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Write the chosen colors to the report's visual definition files">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                        <FontIcon FontSize="14" Glyph="&#xE73E;" />
                        <TextBlock Text="Apply to report" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="AddValueButton"
                    Height="32"
                    Padding="10,0"
                    Click="AddValue_Click"
                    CornerRadius="{StaticResource RadiusMedium}"
                    ToolTipService.ToolTip="Add a value and choose its color and scope">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="Add value" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock
                x:Name="SummaryText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource MutedCaptionTextStyle}"
                Text="" />
        </Grid>

        <!--  Row 2 · Content  -->
        <Grid Grid.Row="2">
            <Border x:Name="ListCard" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="14,10,14,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Values" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource MutedCaptionTextStyle}"
                            Text="Click a swatch to change its color" />
                    </Grid>

                    <ListView
                        x:Name="RulesListView"
                        Grid.Row="1"
                        Padding="6,2,6,6"
                        SelectionMode="None">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="local:SemanticColorRuleGroup">
                                        <Grid Margin="8,12,8,2" ColumnSpacing="{StaticResource SpaceS}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{x:Bind Title}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource MutedCaptionTextStyle}"
                                                Text="{x:Bind Summary}" />
                                        </Grid>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:SemanticColorRuleItem">
                                <Grid
                                    Margin="0,2"
                                    Padding="8,6"
                                    ColumnSpacing="{StaticResource SpaceM}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        Grid.Column="0"
                                        Width="40"
                                        Height="40"
                                        Padding="0"
                                        AutomationProperties.Name="Choose color"
                                        Click="Swatch_Click"
                                        CornerRadius="{StaticResource RadiusMedium}"
                                        ToolTipService.ToolTip="Choose color">
                                        <Border
                                            Width="24"
                                            Height="24"
                                            Background="{x:Bind SwatchBrush, Mode=OneWay}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSmall}" />
                                    </Button>

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Value, Mode=OneWay}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="{x:Bind ScopeGlyph, Mode=OneWay}" />
                                            <TextBlock
                                                Style="{StaticResource RowSubtitleTextStyle}"
                                                Text="{x:Bind ScopeText, Mode=OneWay}" />
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                Glyph="&#xE7BA;"
                                                ToolTipService.ToolTip="One or more selected pages no longer exist"
                                                Visibility="{x:Bind MissingVisibility, Mode=OneWay}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource RowSubtitleTextStyle}"
                                        Text="{x:Bind Hex, Mode=OneWay}" />

                                    <Button
                                        Grid.Column="3"
                                        Width="40"
                                        Height="40"
                                        AutomationProperties.Name="Edit value"
                                        Click="EditRule_Click"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        ToolTipService.ToolTip="Edit value, color and scope">
                                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                    </Button>

                                    <Button
                                        Grid.Column="4"
                                        Width="40"
                                        Height="40"
                                        AutomationProperties.Name="Remove value"
                                        Click="DeleteRule_Click"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        ToolTipService.ToolTip="Remove this value">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!--  Empty: no report loaded  -->
            <StackPanel
                x:Name="NoReportPanel"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="{StaticResource SpaceM}"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="40"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE790;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource ToolTitleTextStyle}"
                    Text="No report loaded" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource MutedCaptionTextStyle}"
                    Text="Open a Power BI project (.pbip) folder from the Home page to manage its visual colors."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    Margin="0,4,0,0"
                    Click="GoToHome_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                        <FontIcon FontSize="14" Glyph="&#xE80F;" />
                        <TextBlock Text="Go to Home" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  Empty: report loaded but no values added  -->
            <StackPanel
                x:Name="NoValuesPanel"
                MaxWidth="460"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="{StaticResource SpaceS}"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="32"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE721;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource ToolTitleTextStyle}"
                    Text="No values yet" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource MutedCaptionTextStyle}"
                    Text="Add a value such as &quot;Enterprise&quot; or &quot;Yes&quot;, pick a color, and choose whether it applies to the whole report or specific pages."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    Click="AddValue_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="Add value" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--  Row 3 · Footer  -->
        <Grid Grid.Row="3" Margin="4,10,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="ReportPathText"
                VerticalAlignment="Center"
                Style="{StaticResource MutedCaptionTextStyle}"
                Text="No report loaded"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource MutedCaptionTextStyle}"
                Text="Values are saved per report; apply writes to the report" />
        </Grid>
    </Grid>
</Page>
