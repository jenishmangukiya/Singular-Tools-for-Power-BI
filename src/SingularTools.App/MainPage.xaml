<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SingularTools_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SingularTools_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent" Padding="20,12,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     PlaceholderText="Type to search pages, or > for commands (>sort az, >sort natural, >duplicate, >delete)..."
                     FontSize="15"
                     Height="42"
                     CornerRadius="8"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"
                     KeyDown="SearchBox_KeyDown" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0">
                <Button x:Name="OpenFolderButton" ToolTipService.ToolTip="Select PBIP Report Folder" Click="OpenFolderButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xED25;" FontSize="14" />
                        <TextBlock Text="Open Report" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Quick Action Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SortAzBtn" Click="SortAz_Click" ToolTipService.ToolTip="Sort Pages A to Z">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE8CB;" FontSize="13" />
                        <TextBlock Text="Sort A-Z" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="SortZaBtn" Click="SortZa_Click" ToolTipService.ToolTip="Sort Pages Z to A">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE8CC;" FontSize="13" />
                        <TextBlock Text="Sort Z-A" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="SortNumBtn" Click="SortNatural_Click" ToolTipService.ToolTip="Smart Natural Numeric Sort (Page 1, 2, 10)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE8D2;" FontSize="13" />
                        <TextBlock Text="Natural Sort" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="SortRevBtn" Click="SortReverse_Click" ToolTipService.ToolTip="Invert Page Order">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE8B1;" FontSize="13" />
                        <TextBlock Text="Reverse" FontSize="12" />
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="GoToPageBtn" Click="GoToPage_Click" ToolTipService.ToolTip="When on, selecting a page navigates the open Power BI report to that page">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE72A;" FontSize="13" />
                        <TextBlock Text="Go to page in Open Report" FontSize="12" />
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="SaveBtn" Click="Save_Click" ToolTipService.ToolTip="Save Order to Power BI Project">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE74E;" FontSize="13" />
                        <TextBlock Text="Save Changes" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock x:Name="PageCountText" Grid.Column="1" VerticalAlignment="Center" 
                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0 pages" />
        </Grid>

        <!-- Main Content Area: Pages List / Command List -->
        <Grid Grid.Row="2">
            <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ListView x:Name="PagesListView"
                          SelectionMode="Single"
                          CanReorderItems="True"
                          CanDragItems="True"
                          AllowDrop="True"
                          DragItemsCompleted="PagesListView_DragItemsCompleted"
                          SelectionChanged="PagesListView_SelectionChanged"
                          KeyDown="PagesListView_KeyDown"
                          Padding="6">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PageItemViewModel">
                            <Grid Padding="8,6" Margin="0,2" CornerRadius="6" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Set as Active Page" Click="ContextMenu_SetActive_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE735;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Duplicate Page (Ctrl+D)" Click="ContextMenu_Duplicate_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Toggle Hidden / Visible" Click="ContextMenu_ToggleHide_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED1A;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Move to Top" Click="ContextMenu_MoveToTop_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE898;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Move to Bottom" Click="ContextMenu_MoveToBottom_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Delete Page (Del)" Click="ContextMenu_Delete_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>

                                <!-- Drag Grip Handle -->
                                <FontIcon Grid.Column="0" Glyph="&#xE769;" FontSize="12" 
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                          VerticalAlignment="Center" HorizontalAlignment="Left" ToolTipService.ToolTip="Drag to Reorder" />

                                <!-- Order Index Badge -->
                                <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Width="30" Height="26" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="{x:Bind OrderIndexText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>

                                <!-- Page Title & ID -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,8,0">
                                    <TextBlock Text="{x:Bind DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Badges (Active, Hidden, Size) -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Padding="6,2" Visibility="{x:Bind ActiveBadgeVisibility}">
                                        <TextBlock Text="★ Active" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    </Border>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" Visibility="{x:Bind HiddenBadgeVisibility}">
                                        <TextBlock Text="Hidden" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Border>
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{x:Bind SizeText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                    <Button ToolTipService.ToolTip="Duplicate Page (Ctrl+D)" Click="Duplicate_Click" Tag="{x:Bind Id}" Width="28" Height="28" Padding="0">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                    </Button>
                                    <Button ToolTipService.ToolTip="Move Up (Alt+Up)" Click="MoveUp_Click" Tag="{x:Bind Id}" Width="28" Height="28" Padding="0">
                                        <FontIcon Glyph="&#xE74A;" FontSize="11" />
                                    </Button>
                                    <Button ToolTipService.ToolTip="Move Down (Alt+Down)" Click="MoveDown_Click" Tag="{x:Bind Id}" Width="28" Height="28" Padding="0">
                                        <FontIcon Glyph="&#xE74B;" FontSize="11" />
                                    </Button>
                                    <Button ToolTipService.ToolTip="Toggle Hidden / Visible" Click="ToggleHide_Click" Tag="{x:Bind Id}" Width="28" Height="28" Padding="0">
                                        <FontIcon Glyph="&#xED1A;" FontSize="11" />
                                    </Button>
                                    <Button ToolTipService.ToolTip="Delete Page" Click="Delete_Click" Tag="{x:Bind Id}" Width="28" Height="28" Padding="0">
                                        <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <!-- Footer / Notification Bar -->
        <Grid Grid.Row="3" Margin="4,12,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE890;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="StatusMessageText" Text="Ready" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Hotkey: Ctrl+Alt+P (Power BI Only)" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="ReportPathText" Text="No report loaded" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
