<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SingularTools_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SingularTools_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Singular Tools"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Custom draggable title bar  -->
        <Grid x:Name="AppTitleBar" Height="36" Padding="16,0,0,0" Background="Transparent">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Image
                    x:Name="AppTitleBarLogo"
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Singular Tools" />
                <TextBlock
                    x:Name="TitleBarToolText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="" />
            </StackPanel>
        </Grid>

        <!--  Tool shell: compact rail + hosted tool pages  -->
        <NavigationView
            x:Name="ToolNav"
            Grid.Row="1"
            AlwaysShowHeader="False"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="220"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="ToolNav_SelectionChanged">
            <Frame x:Name="ToolFrame" />
        </NavigationView>

        <!--  Multi-report guard: blurs the whole tool area and blocks input  -->
        <Grid
            x:Name="MultiReportOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            Canvas.ZIndex="200"
            Visibility="Collapsed">
            <!--
                The "blur" is an acrylic backdrop over the tool shell: WinUI renders
                the content behind it through a blur + noise pass, which gives the
                paused look without pulling in Win2D or hand-rolling a bitmap effect.
            -->
            <Grid.Background>
                <AcrylicBrush
                    AlwaysUseFallback="False"
                    FallbackColor="#E60C0C0C"
                    TintColor="#000000"
                    TintOpacity="0.35" />
            </Grid.Background>

            <Border
                MaxWidth="460"
                Padding="28,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusLarge}">
                <StackPanel Spacing="{StaticResource SpaceL}">
                    <Border
                        Width="44"
                        Height="44"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource RadiusMedium}">
                        <FontIcon
                            FontSize="22"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE7BA;" />
                    </Border>

                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource ToolTitleTextStyle}"
                        Text="Multiple Power BI reports are open"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource MutedCaptionTextStyle}"
                        Text="Singular Tools can only work with one Power BI Desktop report at a time, so the tools are paused. Close the other report and this will clear by itself."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Name="MultiReportDetailText"
                        HorizontalAlignment="Center"
                        Style="{StaticResource MutedCaptionTextStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  Non-blocking toast overlay: bottom-right, above all content  -->
        <StackPanel
            x:Name="ToastHost"
            Grid.Row="0"
            Grid.RowSpan="2"
            Margin="0,0,16,16"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Spacing="8"
            Canvas.ZIndex="100" />
    </Grid>
</Window>
