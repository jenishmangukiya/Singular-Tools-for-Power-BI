<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SingularTools_App.Tools.Home.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="using:SingularTools_App.Shell"
    mc:Ignorable="d">

    <Grid Background="Transparent" Padding="{StaticResource ToolPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource SpaceXXL}">

                <!--  Hero  -->
                <Grid ColumnSpacing="{StaticResource SpaceL}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        x:Name="HomeLogo"
                        Width="56"
                        Height="56"
                        VerticalAlignment="Center" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="{StaticResource SpaceXXS}">
                        <TextBlock
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="Singular Tools" />
                        <TextBlock Style="{StaticResource MutedCaptionTextStyle}" Text="Utilities for Power BI Desktop authors" />
                    </StackPanel>
                </Grid>

                <!--  Report  -->
                <StackPanel Spacing="{StaticResource SpaceM}">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Report" />
                    <Border Padding="16,14" Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnSpacing="{StaticResource SpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource SpaceXXS}">
                                <TextBlock x:Name="ReportNameText" Style="{StaticResource RowTitleTextStyle}" Text="No report loaded" />
                                <TextBlock
                                    x:Name="ReportHintText"
                                    Style="{StaticResource RowSubtitleTextStyle}"
                                    Text="Open a Power BI project (.pbip) folder to manage its report pages."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                x:Name="OpenReportButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="OpenReportButton_Click"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                    <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                    <TextBlock Text="Open Report" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  Tools  -->
                <StackPanel Spacing="{StaticResource SpaceM}">
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Tools" />
                    <GridView
                        x:Name="ToolsGrid"
                        IsItemClickEnabled="True"
                        ItemClick="ToolsGrid_ItemClick"
                        SelectionMode="None"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="shell:ToolDescriptor">
                                <Border
                                    Width="290"
                                    Height="132"
                                    Style="{StaticResource CardBorderStyle}">
                                    <StackPanel
                                        Margin="16,14,16,14"
                                        Spacing="{StaticResource SpaceS}">
                                        <Border
                                            Width="36"
                                            Height="36"
                                            HorizontalAlignment="Left"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="{StaticResource RadiusMedium}">
                                            <FontIcon FontSize="18" Glyph="{x:Bind Glyph}" />
                                        </Border>
                                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Title}" />
                                        <TextBlock
                                            MaxLines="2"
                                            Style="{StaticResource RowSubtitleTextStyle}"
                                            Text="{x:Bind Description}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <TextBlock Style="{StaticResource MutedCaptionTextStyle}" Text="More tools are on the way." />
            </StackPanel>
        </ScrollViewer>

        <!--  Footer: opened report + auto-save note  -->
        <Grid Grid.Row="1" Margin="4,12,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="ReportPathText"
                VerticalAlignment="Center"
                Style="{StaticResource MutedCaptionTextStyle}"
                Text="No report loaded"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource MutedCaptionTextStyle}"
                Text="Changes save automatically" />
        </Grid>
    </Grid>
</Page>
