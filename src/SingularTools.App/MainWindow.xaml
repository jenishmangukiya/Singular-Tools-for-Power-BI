<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SingularTools_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SingularTools_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Singular Tools"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Custom draggable title bar  -->
        <Grid x:Name="AppTitleBar" Height="36" Padding="16,0,0,0" Background="Transparent">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Image
                    x:Name="AppTitleBarLogo"
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Singular Tools" />
                <TextBlock
                    x:Name="TitleBarToolText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="" />
            </StackPanel>
        </Grid>

        <!--  Tool shell: compact rail + hosted tool pages  -->
        <NavigationView
            x:Name="ToolNav"
            Grid.Row="1"
            AlwaysShowHeader="False"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="248"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="ToolNav_SelectionChanged"
            ItemInvoked="ToolNav_ItemInvoked">
            <NavigationView.FooterMenuItems>
                <!--
                    Source link. Uses a PathIcon because Segoe Fluent has no GitHub
                    glyph; SelectsOnInvoked is false so it acts without changing the
                    selected tool. Opened by Tag in ItemInvoked.
                -->
                <NavigationViewItem
                    x:Name="GitHubItem"
                    Content="GitHub"
                    SelectsOnInvoked="False"
                    Tag="github"
                    ToolTipService.ToolTip="Open the project on GitHub">
                    <NavigationViewItem.Icon>
                        <PathIcon Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!--
                    A footer action item rather than a ToggleSwitch: the rail is a
                    48px compact strip, so an inline switch would be clipped. The
                    icon/label report the action the click will perform.
                -->
                <NavigationViewItem
                    x:Name="ThemeToggleItem"
                    Content="Dark mode"
                    SelectsOnInvoked="False"
                    Tag="theme-toggle"
                    ToolTipService.ToolTip="Switch to the dark theme">
                    <NavigationViewItem.Icon>
                        <FontIcon x:Name="ThemeToggleIcon" Glyph="&#xE708;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ToolFrame" />
        </NavigationView>

        <!--  Multi-report guard: blurs the whole tool area and blocks input  -->
        <Grid
            x:Name="MultiReportOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            Canvas.ZIndex="200"
            Visibility="Collapsed">
            <!--
                The "blur" is an acrylic backdrop over the tool shell: WinUI renders
                the content behind it through a blur + noise pass, which gives the
                paused look without pulling in Win2D or hand-rolling a bitmap effect.
            -->
            <Grid.Background>
                <AcrylicBrush
                    AlwaysUseFallback="False"
                    FallbackColor="#E60C0C0C"
                    TintColor="#000000"
                    TintOpacity="0.35" />
            </Grid.Background>

            <Border
                MaxWidth="460"
                Padding="28,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusLarge}">
                <StackPanel Spacing="{StaticResource SpaceL}">
                    <Border
                        Width="44"
                        Height="44"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource RadiusMedium}">
                        <FontIcon
                            FontSize="22"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE7BA;" />
                    </Border>

                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource ToolTitleTextStyle}"
                        Text="Multiple Power BI reports are open"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource MutedCaptionTextStyle}"
                        Text="Singular Tools can only work with one Power BI Desktop report at a time, so the tools are paused. Close the other report and this will clear by itself."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Name="MultiReportDetailText"
                        HorizontalAlignment="Center"
                        Style="{StaticResource MutedCaptionTextStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  Non-blocking toast overlay: bottom-right, above all content  -->
        <StackPanel
            x:Name="ToastHost"
            Grid.Row="0"
            Grid.RowSpan="2"
            Margin="0,0,16,16"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Spacing="8"
            Canvas.ZIndex="100" />

        <!--  Startup sync: shown until Power BI Desktop's save has landed  -->
        <Grid
            x:Name="StartupOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            Canvas.ZIndex="150"
            Visibility="Collapsed">
            <Grid.Background>
                <AcrylicBrush
                    AlwaysUseFallback="False"
                    FallbackColor="#E60C0C0C"
                    TintColor="#000000"
                    TintOpacity="0.35" />
            </Grid.Background>

            <Border
                MaxWidth="420"
                Padding="28,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusLarge}">
                <StackPanel Spacing="{StaticResource SpaceL}">
                    <ProgressRing
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Center"
                        IsActive="True" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource ToolTitleTextStyle}"
                        Text="Getting the latest data"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Name="StartupDetailText"
                        HorizontalAlignment="Center"
                        Style="{StaticResource MutedCaptionTextStyle}"
                        Text="Saving the report open in Power BI Desktop so the tools show your latest edits…"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
