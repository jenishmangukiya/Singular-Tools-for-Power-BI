<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SingularTools_App.Tools.ReportPublishingManager.ReportPublishingManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SingularTools_App.Tools.ReportPublishingManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent" Padding="{StaticResource ToolPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Row 0 · Report banner  -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="16,12" Style="{StaticResource CardBorderStyle}">
            <Grid ColumnSpacing="{StaticResource SpaceL}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="36"
                    Height="36"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="{StaticResource RadiusMedium}">
                    <FontIcon
                        x:Name="ReportStatusGlyph"
                        FontSize="18"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE7BA;" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource SpaceXXS}">
                    <TextBlock x:Name="ReportNameText" Style="{StaticResource RowTitleTextStyle}" Text="Power BI Desktop is not running" />
                    <TextBlock
                        x:Name="ReportHintText"
                        Style="{StaticResource RowSubtitleTextStyle}"
                        Text="Open the report in Power BI Desktop, then detect workspaces to publish to."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Row 1 · Toolbar  -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                <Button
                    x:Name="DetectButton"
                    Height="32"
                    Padding="10,0"
                    Click="DetectButton_Click"
                    CornerRadius="{StaticResource RadiusMedium}"
                    ToolTipService.ToolTip="Read the available workspaces from Power BI Desktop">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock x:Name="DetectButtonText" Text="Detect workspaces" />
                    </StackPanel>
                </Button>

                <TextBlock
                    x:Name="LastDetectedText"
                    VerticalAlignment="Center"
                    Style="{StaticResource MutedCaptionTextStyle}"
                    Visibility="Collapsed" />

                <Button
                    x:Name="SelectAllButton"
                    Height="32"
                    Padding="10,0"
                    Click="SelectAllButton_Click"
                    CornerRadius="{StaticResource RadiusMedium}"
                    ToolTipService.ToolTip="Select / clear all workspaces">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                        <FontIcon FontSize="14" Glyph="&#xE73E;" />
                        <TextBlock Text="Select all" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="ClearButton"
                    Height="32"
                    Padding="10,0"
                    Click="ClearButton_Click"
                    CornerRadius="{StaticResource RadiusMedium}"
                    ToolTipService.ToolTip="Clear the workspace selection">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                        <FontIcon FontSize="14" Glyph="&#xE711;" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                <Button
                    x:Name="CancelButton"
                    Height="32"
                    Padding="10,0"
                    Click="CancelButton_Click"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                        <FontIcon FontSize="14" Glyph="&#xE711;" />
                        <TextBlock Text="Cancel" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="PublishButton"
                    Height="32"
                    Padding="14,0"
                    Click="PublishButton_Click"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Publish to every selected workspace">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                        <FontIcon FontSize="14" Glyph="&#xE724;" />
                        <TextBlock Text="Publish selected" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--  Row 2 · Content  -->
        <Grid Grid.Row="2">
            <Border x:Name="ListCard" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  List header  -->
                    <Grid Margin="14,10,14,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Workspaces" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource MutedCaptionTextStyle}"
                            Text="Existing reports are replaced automatically" />
                    </Grid>

                    <ListView
                        x:Name="WorkspacesListView"
                        Grid.Row="1"
                        Padding="6,2,6,6"
                        IsItemClickEnabled="False"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:WorkspaceItemViewModel">
                                <Grid
                                    Margin="0,1"
                                    Padding="10,7"
                                    ColumnSpacing="{StaticResource SpaceM}"
                                    CornerRadius="{StaticResource RadiusMedium}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Checked="WorkspaceCheckBox_Changed"
                                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                        MinWidth="0"
                                        Unchecked="WorkspaceCheckBox_Changed" />

                                    <Border
                                        Grid.Column="1"
                                        Width="30"
                                        Height="30"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="{StaticResource RadiusSmall}">
                                        <FontIcon FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8FD;" />
                                    </Border>

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource RowTitleTextStyle}"
                                        Text="{x:Bind Name}" />

                                    <StackPanel
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="{StaticResource SpaceS}"
                                        Visibility="{x:Bind StatusVisibility, Mode=OneWay}">
                                        <FontIcon FontSize="12" Glyph="{x:Bind StatusGlyph, Mode=OneWay}" />
                                        <TextBlock
                                            Style="{StaticResource MutedCaptionTextStyle}"
                                            Text="{x:Bind StatusText, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!--  Empty state  -->
            <StackPanel
                x:Name="NoWorkspacesPanel"
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="{StaticResource SpaceM}"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="40"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE8FD;" />
                <TextBlock
                    x:Name="NoWorkspacesTitle"
                    HorizontalAlignment="Center"
                    Style="{StaticResource ToolTitleTextStyle}"
                    Text="No workspaces detected" />
                <TextBlock
                    x:Name="NoWorkspacesHint"
                    HorizontalAlignment="Center"
                    Style="{StaticResource MutedCaptionTextStyle}"
                    Text="Click 'Detect workspaces' to read the list from Power BI Desktop."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    Margin="0,4,0,0"
                    Click="GoToHome_Click"
                    Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                        <FontIcon FontSize="14" Glyph="&#xE80F;" />
                        <TextBlock Text="Go to Home" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--  Row 3 · Footer  -->
        <Grid Grid.Row="3" Margin="4,10,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="SummaryText"
                VerticalAlignment="Center"
                Style="{StaticResource MutedCaptionTextStyle}"
                Text="No workspaces" />

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource MutedCaptionTextStyle}"
                Text="Publishing is driven through Power BI Desktop" />
        </Grid>
    </Grid>
</Page>
