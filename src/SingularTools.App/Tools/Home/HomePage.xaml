<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SingularTools_App.Tools.Home.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:home="using:SingularTools_App.Tools.Home"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            One tool card. A flat Button so hover, keyboard focus and Enter/Space
            activation come from the control instead of hand-rolled states.
            The size is fixed so every card lines up regardless of copy length.
        -->
        <DataTemplate x:Key="ToolCardTemplate" x:DataType="home:ToolCardViewModel">
            <Button
                Width="300"
                Height="138"
                Click="ToolCard_Click"
                Style="{StaticResource ToolCardButtonStyle}"
                Tag="{x:Bind Id}">
                <Grid Padding="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="34"
                            Height="34"
                            HorizontalAlignment="Left"
                            Background="{StaticResource BrandAccentSoftBrush}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Opacity="{x:Bind IconTileOpacity}">
                            <FontIcon FontSize="16" Glyph="{x:Bind Glyph}" />
                        </Border>

                        <Border
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Style="{StaticResource StatChipStyle}"
                            Visibility="{x:Bind BadgeVisibility}">
                            <TextBlock Style="{StaticResource StatChipTextStyle}" Text="{x:Bind BadgeText}" />
                        </Border>
                    </Grid>

                    <StackPanel
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        Spacing="{StaticResource SpaceXXS}">
                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Title}" />
                        <TextBlock
                            MaxLines="2"
                            Style="{StaticResource RowSubtitleTextStyle}"
                            Text="{x:Bind Description}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!--
            One titled group. Cards are a fixed width and wrap as the window
            widens, so a two-card group never stretches into a pair of banners.
        -->
        <DataTemplate x:Key="ToolSectionTemplate" x:DataType="home:ToolSectionViewModel">
            <StackPanel Spacing="{StaticResource SpaceM}">
                <TextBlock Style="{StaticResource GroupHeaderTextStyle}" Text="{x:Bind Title}" />
                <ItemsRepeater ItemTemplate="{StaticResource ToolCardTemplate}" ItemsSource="{x:Bind Cards}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinColumnSpacing="{StaticResource SpaceL}"
                            MinItemHeight="138"
                            MinItemWidth="300"
                            MinRowSpacing="{StaticResource SpaceL}"
                            Orientation="Horizontal"
                            ItemsStretch="None" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer
        Padding="{StaticResource ToolPagePadding}"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{StaticResource SpaceXXL}">

            <!--  Brand  -->
            <Grid ColumnSpacing="{StaticResource SpaceL}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    x:Name="HomeLogo"
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource SpaceXXS}">
                    <TextBlock Style="{StaticResource ToolTitleTextStyle}" Text="Singular Tools" />
                    <TextBlock Style="{StaticResource MutedCaptionTextStyle}" Text="Utilities for Power BI Desktop authors" />
                </StackPanel>
            </Grid>

            <!--
                Report band. The accent sheen is a separate layer behind the
                content so it can fade across the card without tinting the text.
            -->
            <Border Style="{StaticResource HeroBorderStyle}">
                <Grid>
                    <Border
                        Background="{StaticResource BrandSheenBrush}"
                        CornerRadius="{StaticResource RadiusLarge}"
                        IsHitTestVisible="False"
                        Opacity="0.25" />

                    <Grid Padding="20,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="{StaticResource SpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource SpaceXXS}">
                                <TextBlock
                                    x:Name="ReportNameText"
                                    Style="{StaticResource ToolTitleTextStyle}"
                                    Text="No report loaded"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="ReportPathText"
                                    Style="{StaticResource MutedCaptionTextStyle}"
                                    Text="Open a Power BI project (.pbip) folder to get started."
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button
                                x:Name="OpenReportButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="OpenReportButton_Click"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                    <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                    <TextBlock x:Name="OpenReportButtonText" Text="Open report" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!--  Live facts about the open report; toggled in code-behind  -->
                        <StackPanel
                            Grid.Row="1"
                            Margin="0,14,0,0"
                            Orientation="Horizontal"
                            Spacing="{StaticResource SpaceS}">
                            <Border x:Name="PagesChip" Style="{StaticResource AccentChipStyle}" Visibility="Collapsed">
                                <TextBlock x:Name="PagesChipText" Style="{StaticResource StatChipTextStyle}" />
                            </Border>

                            <Border x:Name="ModelChip" Style="{StaticResource StatChipStyle}" Visibility="Collapsed">
                                <TextBlock x:Name="ModelChipText" Style="{StaticResource StatChipTextStyle}" />
                            </Border>
                            <Border x:Name="DesktopChip" Style="{StaticResource StatChipStyle}" Visibility="Collapsed">
                                <TextBlock x:Name="DesktopChipText" Style="{StaticResource StatChipTextStyle}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!--  Tools, grouped by the job they belong to  -->
            <ItemsRepeater x:Name="SectionsRepeater" ItemTemplate="{StaticResource ToolSectionTemplate}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="{StaticResource SpaceXXL}" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <!--
                Footer: what the tools are built for, who built them, and where the
                source lives. Logos are loaded at runtime so they follow the same
                unpackaged-app asset path as the rest of the brand art.
            -->
            <Border
                Margin="0,4,0,0"
                Padding="18,14"
                Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="{StaticResource SpaceL}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  What it is built for  -->
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="{StaticResource SpaceL}">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MutedCaptionTextStyle}"
                            Text="Built for" />

                        <Border
                            Padding="8,5"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            ToolTipService.ToolTip="Microsoft Power BI">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                <Image
                                    x:Name="PowerBiLogo"
                                    Width="18"
                                    Height="18"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BadgeTextStyle}"
                                    Text="Power BI" />
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="8,5"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            ToolTipService.ToolTip="Microsoft Fabric">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                <Image
                                    x:Name="FabricLogo"
                                    Width="18"
                                    Height="18"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BadgeTextStyle}"
                                    Text="Microsoft Fabric" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  Who built it, and where the source lives  -->
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="{StaticResource SpaceL}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource MutedCaptionTextStyle}"
                                Text="Made by" />
                            <HyperlinkButton
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Jenish Mangukiya on GitHub"
                                MinHeight="0"
                                NavigateUri="https://github.com/jenishmangukiya/"
                                Padding="0"
                                ToolTipService.ToolTip="Open Jenish Mangukiya's GitHub profile">
                                <TextBlock
                                    Style="{StaticResource BadgeTextStyle}"
                                    Text="Jenish Mangukiya" />
                            </HyperlinkButton>
                        </StackPanel>

                        <Rectangle
                            Width="1"
                            Height="18"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <HyperlinkButton
                            AutomationProperties.Name="GitHub repository"
                            NavigateUri="https://github.com/jenishmangukiya/Singular-Tools-for-Power-BI"
                            Padding="4,2"
                            ToolTipService.ToolTip="Open the GitHub repository">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                <Path
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Stretch="Uniform"
                                    Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                                <TextBlock VerticalAlignment="Center" Text="Singular-Tools-for-Power-BI" />
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
