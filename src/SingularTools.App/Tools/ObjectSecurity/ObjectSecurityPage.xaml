<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SingularTools_App.Tools.ObjectSecurity.ObjectSecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SingularTools_App.Tools.ObjectSecurity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent" Padding="{StaticResource ToolPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Row 0 · Model banner  -->
        <Border Margin="0,0,0,10" Padding="16,12" Style="{StaticResource CardBorderStyle}">
            <Grid ColumnSpacing="{StaticResource SpaceL}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="36"
                    Height="36"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="{StaticResource RadiusMedium}">
                    <FontIcon
                        FontSize="18"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE72E;" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource SpaceXXS}">
                    <TextBlock x:Name="ModelNameText" Style="{StaticResource RowTitleTextStyle}" Text="No semantic model found" />
                    <TextBlock
                        x:Name="ModelHintText"
                        Style="{StaticResource RowSubtitleTextStyle}"
                        Text="Open a Power BI project (.pbip) to manage its roles."
                        TextWrapping="Wrap" />
                    <StackPanel
                        x:Name="PowerBiWarning"
                        Orientation="Horizontal"
                        Spacing="{StaticResource SpaceXS}"
                        Visibility="Collapsed">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Glyph="&#xE7BA;" />
                        <TextBlock
                            Style="{StaticResource MutedCaptionTextStyle}"
                            Text="OLS is written to the model's role files on disk. If Power BI Desktop is open, the external change is applied for you after each apply."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Row 1 · Toolbar  -->
        <Grid Grid.Row="1" Margin="2,0,2,10" ColumnSpacing="{StaticResource SpaceM}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="NewRoleButton"
                Click="NewRoleButton_Click"
                Style="{StaticResource ToolbarButtonStyle}"
                ToolTipService.ToolTip="Create a new OLS role">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="New role" />
                </StackPanel>
            </Button>

            <Button
                x:Name="RenameRoleButton"
                Grid.Column="1"
                Click="RenameRoleButton_Click"
                IsEnabled="False"
                Style="{StaticResource ToolbarButtonStyle}"
                ToolTipService.ToolTip="Rename the selected role">
                <TextBlock Text="Rename" />
            </Button>

            <Button
                x:Name="DeleteRoleButton"
                Grid.Column="2"
                Click="DeleteRoleButton_Click"
                IsEnabled="False"
                Style="{StaticResource ToolbarButtonStyle}"
                ToolTipService.ToolTip="Delete the selected role">
                <TextBlock Text="Delete" />
            </Button>

            <TextBox
                x:Name="SearchBox"
                Grid.Column="3"
                Width="180"
                PlaceholderText="Search tables and columns"
                TextChanged="SearchBox_TextChanged"
                ToolTipService.ToolTip="Filter the object list" />

            <TextBlock
                x:Name="PlanSummaryText"
                Grid.Column="4"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource MutedCaptionTextStyle}" />

            <Button
                x:Name="UndoButton"
                Grid.Column="5"
                Click="UndoButton_Click"
                IsEnabled="False"
                Style="{StaticResource ToolbarButtonStyle}"
                ToolTipService.ToolTip="Restore the role files changed by the last apply">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                    <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                    <TextBlock Text="Undo last apply" />
                </StackPanel>
            </Button>

            <Button
                x:Name="ApplyButton"
                Grid.Column="6"
                Click="ApplyButton_Click"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="Write the staged OLS rules to the model">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                    <FontIcon FontSize="14" Glyph="&#xE73E;" />
                    <TextBlock x:Name="ApplyButtonText" Text="Apply changes" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  Row 2 · Roles + objects  -->
        <Grid Grid.Row="2" ColumnSpacing="{StaticResource SpaceL}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="6" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="8,6,8,6"
                        Style="{StaticResource SectionHeaderTextStyle}"
                        Text="Roles" />

                    <ListView
                        x:Name="RolesList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind Roles}"
                        SelectionChanged="RolesList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:RoleItemViewModel">
                                <Grid Padding="6,4" ColumnSpacing="{StaticResource SpaceM}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowTitleTextStyle}" Text="{x:Bind Name}" />
                                        <TextBlock Style="{StaticResource MutedCaptionTextStyle}" Text="{x:Bind Summary, Mode=OneWay}" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BadgePillStyle}">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BadgeTextStyle}"
                                            Text="{x:Bind KindLabel, Mode=OneWay}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <ScrollViewer x:Name="TablesScroll" Visibility="Collapsed">
                    <StackPanel>
                        <!--  RLS notice  -->
                        <Border
                            x:Name="RoleWarning"
                            Margin="0,0,0,10"
                            Padding="12,10"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceM}">
                                <FontIcon
                                    VerticalAlignment="Top"
                                    FontSize="16"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Glyph="&#xE7BA;" />
                                <TextBlock
                                    Style="{StaticResource MutedCaptionTextStyle}"
                                    Text="This role also applies row-level filters. OLS rules are stored alongside them in the same role — just note that a user who is also in another role combining RLS and OLS can hit query-time errors."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!--  Validation  -->
                        <Expander
                            x:Name="IssuesExpander"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">
                            <ItemsControl ItemsSource="{x:Bind Issues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:IssueViewModel">
                                        <Grid Margin="0,1" Padding="4,3" ColumnSpacing="{StaticResource SpaceM}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Top"
                                                FontSize="14"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="{x:Bind Glyph}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource MutedCaptionTextStyle}"
                                                Text="{x:Bind Message}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <!--  Tables  -->
                        <ItemsControl ItemsSource="{x:Bind Tables}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:TableNodeViewModel">
                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="14,12"
                                        Style="{StaticResource CardBorderStyle}"
                                        Visibility="{x:Bind IsVisible, Mode=OneWay}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid ColumnSpacing="{StaticResource SpaceM}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SectionHeaderTextStyle}"
                                                    Text="{x:Bind TableName}" />

                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MutedCaptionTextStyle}"
                                                    Text="{x:Bind HiddenSummary, Mode=OneWay}" />

                                                <StackPanel
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="{StaticResource SpaceS}">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource MutedCaptionTextStyle}"
                                                        Text="Hide table" />
                                                    <ToggleSwitch
                                                        MinWidth="0"
                                                        IsEnabled="{x:Bind IsToggleEnabled, Mode=OneWay}"
                                                        IsOn="{x:Bind IsHidden, Mode=TwoWay}"
                                                        OffContent=""
                                                        OnContent="" />
                                                </StackPanel>
                                            </Grid>

                                            <ItemsControl
                                                Grid.Row="1"
                                                Margin="0,6,0,0"
                                                ItemsSource="{x:Bind Columns}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:ColumnNodeViewModel">
                                                        <Grid
                                                            Margin="0,1"
                                                            Padding="8,3"
                                                            ColumnSpacing="{StaticResource SpaceM}"
                                                            Visibility="{x:Bind IsVisible, Mode=OneWay}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource RowTitleTextStyle}"
                                                                Text="{x:Bind ColumnName}" />

                                                            <Border
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource BadgePillStyle}"
                                                                Visibility="{x:Bind StateBadgeVisibility, Mode=OneWay}">
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource BadgeTextStyle}"
                                                                    Text="{x:Bind StateBadge, Mode=OneWay}" />
                                                            </Border>

                                                            <ToggleSwitch
                                                                Grid.Column="2"
                                                                MinWidth="0"
                                                                IsEnabled="{x:Bind IsToggleEnabled, Mode=OneWay}"
                                                                IsOn="{x:Bind IsHidden, Mode=TwoWay}"
                                                                OffContent=""
                                                                OnContent="" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!--  Status / empty state  -->
                <StackPanel
                    x:Name="EmptyPanel"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource SpaceM}"
                    Visibility="Collapsed">
                    <FontIcon
                        x:Name="EmptyIcon"
                        HorizontalAlignment="Center"
                        FontSize="40"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE72E;" />
                    <TextBlock
                        x:Name="EmptyTitle"
                        HorizontalAlignment="Center"
                        Style="{StaticResource ToolTitleTextStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="EmptyMessage"
                        HorizontalAlignment="Center"
                        Style="{StaticResource MutedCaptionTextStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="EmptyActionButton"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0"
                        Click="EmptyActionButton_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Grid>

        <!--  Row 3 · Footer  -->
        <TextBlock
            x:Name="FooterText"
            Grid.Row="3"
            Margin="4,10,4,0"
            Style="{StaticResource MutedCaptionTextStyle}"
            Text="Object-level security hides tables or columns from a role. Rules are staged here and written when you apply."
            TextWrapping="Wrap" />
    </Grid>
</Page>
